# Supabase (Settings > API di dashboard Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Service role key (Settings > API > service_role) — RAHASIA, jangan pernah expose ke client!
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Gemini API key (aistudio.google.com > Get API Key)
# --- Opsi 1: satu API key saja ---
GEMINI_API_KEY=AQ.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# --- Opsi 2: lebih dari satu API key (auto-switch kalau satu kena limit) ---
# GEMINI_API_KEYS=key_pertama,key_kedua,key_ketiga

# Midtrans (dashboard.midtrans.com > Settings > Access Keys)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
# "true" kalau sudah pakai akun Production Midtrans, "false" kalau masih Sandbox/testing
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# Email akun kamu sendiri, buat akses halaman admin konfirmasi pembayaran manual (/admin/payments)
ADMIN_EMAIL=email_kamu@gmail.com
